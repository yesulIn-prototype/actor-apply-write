{
  "title": "배우 지원서",
  "fileName": "{name}_지원서",
  "note": "예술in 표준 지원서 v1의 기본 정의. 공고별 추가 항목은 표 1의 자기소개 줄 위에 줄로 들어간다(design/standard-form.md).",
  "items": [
    { "id": "name", "label": "이름", "type": "text", "required": true, "maxLength": 30 },
    { "id": "birth", "label": "생년월일", "type": "text", "required": true, "maxLength": 20, "help": "예: 1998.03.01" },
    { "id": "phone", "label": "연락처", "type": "phone", "required": true },
    { "id": "email", "label": "이메일", "type": "text", "maxLength": 80 },
    { "id": "gender", "label": "성별", "type": "single", "required": true,
      "options": [ { "id": "m", "label": "남" }, { "id": "f", "label": "여" } ] },
    { "id": "area", "label": "거주지", "type": "text", "maxLength": 40, "help": "시·구까지만 적어도 돼요" },
    { "id": "height", "label": "키 (cm)", "type": "text", "maxLength": 5 },
    { "id": "weight", "label": "몸무게 (kg)", "type": "text", "maxLength": 5 },
    { "id": "school", "label": "학력", "type": "text", "maxLength": 80, "help": "예: OO대학교 연극영화과 졸업" },
    { "id": "skill", "label": "특기", "type": "text", "maxLength": 80 },
    { "id": "role", "label": "지원 배역", "type": "text", "maxLength": 60 },
    { "id": "current", "label": "현재 출연 작품", "type": "text", "maxLength": 80, "help": "공연·연습 중인 작품이 없으면 비워 두세요" },
    { "id": "unavailable", "label": "참여 불가 일정", "type": "text", "maxLength": 120 },
    { "id": "more", "label": "더 알리고 싶은 것", "type": "rows", "maxRows": 3,
      "help": "영상 링크, 수상, SNS 등 지원서에 넣고 싶은 항목을 더할 수 있어요",
      "columns": [ { "id": "label", "label": "항목" }, { "id": "value", "label": "내용" } ] },
    { "id": "intro", "label": "자기소개·지원동기", "type": "text", "multiline": true, "maxLength": 1500 },
    { "id": "career", "label": "출연 경력", "type": "rows", "maxRows": 20, "help": "최근 작품부터 적어주세요",
      "columns": [ { "id": "title", "label": "작품명" }, { "id": "role", "label": "역할" },
                   { "id": "period", "label": "기간" }, { "id": "venue", "label": "공연장" },
                   { "id": "company", "label": "단체·제작사" } ] },
    { "id": "photoMain", "label": "대표 사진", "type": "photo", "required": true },
    { "id": "photoUpper", "label": "상반신 사진", "type": "photo" },
    { "id": "photoFull", "label": "전신 사진", "type": "photo" },
    { "id": "photoFree", "label": "자유 사진", "type": "photo" }
  ],
  "outputs": [
    { "cell": "0.0.1", "text": "{name}" },
    { "cell": "0.0.3", "text": "{birth}" },
    { "cell": "0.0.4", "photo": "photoMain" },
    { "cell": "0.1.1", "text": "{phone}" },
    { "cell": "0.1.3", "text": "{email}" },
    { "cell": "0.2.1", "text": "{gender}" },
    { "cell": "0.2.3", "text": "{area}" },
    { "cell": "0.3.1", "text": "{height} cm" },
    { "cell": "0.3.3", "text": "{weight} kg" },
    { "cell": "0.4.1", "text": "{school}" },
    { "cell": "0.5.1", "text": "{skill}" },
    { "cell": "1.0.1", "text": "{role}" },
    { "cell": "1.1.1", "text": "{current}" },
    { "cell": "1.2.1", "text": "{unavailable}" },
    { "cell": "1.3.0", "rows": "more", "columns": ["label", "value"], "formRows": 0, "grow": true },
    { "cell": "1.3.1", "text": "{intro}" },
    { "cell": "2.1.0", "rows": "career", "columns": ["title", "role", "period", "venue", "company"], "formRows": 10, "grow": true },
    { "cell": "3.1.0", "photo": "photoUpper" },
    { "cell": "3.1.1", "photo": "photoFull" },
    { "cell": "3.1.2", "photo": "photoFree" }
  ]
}
